# Copy this file to .env in the repo root before running
# `docker compose up --build`. .env is gitignored — never commit real
# secrets. See foodVilla_backend/CONFIGURATION.md for the full per-service
# breakdown (this file only covers what docker-compose.yml itself reads).

# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------

# MySQL root password — used by the mysql container itself AND by every
# backend service's DB_PASSWORD to connect to it.
DB_PASSWORD=changeme-use-a-real-password

# HMAC-SHA256 signing key, shared by all 7 services that touch JWTs
# (user-service issues, the other 6 validate). 32+ random characters.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---------------------------------------------------------------------
# Optional — sensible defaults are already baked into docker-compose.yml
# ---------------------------------------------------------------------

# Origin the backend's CORS config allows. Only matters for browser
# clients (web) — change if you serve the web app from somewhere other
# than the Vite dev server's default port.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Placeholder pricing rules order-service applies to every order.
ORDER_DELIVERY_FEE=40
ORDER_TAX_RATE=0.05

# "mock" (default — no external calls, no real money, always available)
# or "razorpay". Do NOT put real Razorpay keys in any tracked file — only
# ever in this untracked .env, and only if you've actually verified the
# integration against your own Razorpay test account first (see
# CONFIGURATION.md — it hasn't been verified in this repo).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Browser-reachable Gateway URL baked into the web frontend's production
# build (docker-compose.yml's "web" service). Must NOT be a Docker-internal
# hostname like http://api-gateway:8080 — the browser can't resolve that.
# Leave as-is for local Docker use; change only when deploying somewhere
# the Gateway has a different public URL.
VITE_API_BASE_URL=http://localhost:8080
