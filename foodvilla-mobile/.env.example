# Base URL of the API Gateway. Must use the EXPO_PUBLIC_ prefix to be
# readable in app code (see src/config/env.ts).
#
# Which value to use depends on where the app is running — see the
# "Networking" section in README.md for the full explanation:
#   - Expo Go on the same machine as the backend (web preview): http://localhost:8080
#   - Android emulator:  http://10.0.2.2:8080   (10.0.2.2 is the emulator's alias for the host machine's localhost)
#   - iOS simulator:     http://localhost:8080  (shares the host's network namespace)
#   - Physical device (same Wi-Fi as your machine): http://<your-machine-LAN-IP>:8080
#   - Production: your deployed API Gateway URL (e.g. an AWS API Gateway/ALB URL)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
